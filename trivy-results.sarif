            {
              "id": "CVE-2026-98308",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "kernel: ALSA: hda: trace PCM open only after assigning a stream"
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:\n\nALSA: hda: trace PCM open only after assigning a stream\n\nStream assignment can fail when hardware streams are exhausted.\nMove the tracepoint after the NULL check because its payload accesses\nthe assigned stream tag.\n\nDetected by static analysis and reviewed with AI-assisted source auditing."
              },
              "defaultConfiguration": {
