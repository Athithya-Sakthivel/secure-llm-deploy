              "id": "CVE-2026-97495",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "kernel: drm/amdkfd: Check bounds on allocate_doorbell"
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:\n\ndrm/amdkfd: Check bounds on allocate_doorbell\n\nallocated_doorbell has an option to set the doorbell id\nto a specific value (used by CRIU). This value was not\nbounds checked.\n\nCheck to confirm it's less than KFD_MAX_NUM_OF_QUEUES_PER_PROCESS."
              },
              "defaultConfiguration": {
