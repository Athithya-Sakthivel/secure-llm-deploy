              "id": "CVE-2026-111064",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "aiohttp: aiohttp: Denial of Service via missing initial request timeout"
              },
              "fullDescription": {
                "text": "AIOHTTP is an asynchronous HTTP client/server framework for asyncio and Python. Prior to 3.14.4, keepalive timeout handling is absent during the initial portion of a request. An attacker can keep an idle connection open indefinitely before sending any request data, consuming server connection capacity. This issue is fixed in version 3.14.4."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-111064",
