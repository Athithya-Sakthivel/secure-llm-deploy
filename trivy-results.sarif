            {
              "id": "CVE-2026-97520",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:  g ..."
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:\n\ngfs2: move quota_init qc iterator increment\n\nMove qc++ from the loop body into the for-loop increment\nexpression in gfs2_quota_init().\n\nThis keeps iterator progression explicit and avoids mixing pointer\nadvance with duplicate-slot handling in the loop body."
              },
              "defaultConfiguration": {
