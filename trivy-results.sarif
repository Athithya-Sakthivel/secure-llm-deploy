            {
              "id": "CVE-2026-94266",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "curl: curl: password leak in CURLINFO_EFFECTIVE_URL"
              },
              "fullDescription": {
                "text": "A flaw was found in curl. This vulnerability can lead to information disclosure by inadvertently revealing authentication credentials. When curl retrieves credentials from a local configuration file (such as a .netrc file), requesting the effective URL metadata can cause the returned destination address to improperly include those secret credentials. A local user may exploit this issue to view sensitive authentication tokens if an application or script queries and logs or displays the resolved URL."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-94266",
