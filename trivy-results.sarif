            {
              "id": "CVE-2026-97487",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "kernel: jfs: handle set_blocksize failures"
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:\n\njfs: handle set_blocksize failures\n\njfs uses buffer_heads, which don't handle block size \u003e PAGE_SIZE well.\nWithout this, mounting we will hit the\n\n        BUG_ON(offset \u003e= folio_size(folio));\n\nin folio_set_bh on the first __bread_gfp call."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-97487",
              "help": {
