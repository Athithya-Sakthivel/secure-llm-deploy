            {
              "id": "CVE-2026-97425",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "kernel: drm/amdgpu: fix buffer overflow during vBIOS update"
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:\n\ndrm/amdgpu: fix buffer overflow during vBIOS update\n\nClamp the buffer postion to write by setting the bin attribute\nto the maximum buffer size so that VFS layer will block the\nout-of-bounds accessing."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-97425",
