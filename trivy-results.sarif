            {
              "id": "CVE-2026-90334",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "kernel: tty: clear cdev pointer after cdev_add() failure"
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:\n\ntty: clear cdev pointer after cdev_add() failure\n\ntty_cdev_add() drops the cdev reference when cdev_add() fails, but\nleaves driver-\u003ecdevs[index] pointing to freed memory.\ntty_unregister_device() later passes that stale pointer to cdev_del(),\ncausing a use-after-free.\n\nClear the slot after dropping the reference."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-90334",
