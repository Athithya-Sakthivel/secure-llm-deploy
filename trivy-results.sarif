              "id": "CVE-2026-76781",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "libxml2: libxml2: NULL pointer dereference parsing nextCatalog without catalog attribute"
              },
              "fullDescription": {
                "text": "A flaw was found in libxml2. A local user or an attacker providing a specially crafted XML catalog can trigger a NULL pointer dereference during XML catalog parsing. This occurs when a `nextCatalog` element lacks its mandatory `catalog` attribute, leading to the application crashing and causing a Denial of Service (DoS)."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-76781",
