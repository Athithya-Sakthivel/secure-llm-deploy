              "id": "CVE-2026-43308",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "kernel: btrfs: don't BUG() on unexpected delayed ref type in run_one_delayed_ref()"
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:\n\nbtrfs: don't BUG() on unexpected delayed ref type in run_one_delayed_ref()\n\nThere is no need to BUG(), we can just return an error and log an error\nmessage."
              },
              "defaultConfiguration": {
