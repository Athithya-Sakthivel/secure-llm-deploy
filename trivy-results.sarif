            {
              "id": "CVE-2026-98092",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "kernel: ASoC: amd: yc: fix memory leak in acp6x_pdm_dma_close()"
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:\n\nASoC: amd: yc: fix memory leak in acp6x_pdm_dma_close()\n\nacp6x_pdm_dma_close() does not free the runtime-\u003eprivate_data buffer\nallocated in acp6x_pdm_dma_open(). Add the missing kfree."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
