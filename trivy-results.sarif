            {
              "id": "CVE-2026-46675",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "libpng: libpng: Use-after-free in sequential reader when png_read_end called without reading image rows"
              },
              "fullDescription": {
                "text": "A flaw was found in libpng. A remote attacker could exploit this vulnerability to cause a Denial of Service (DoS) by supplying a specially crafted PNG image. Incomplete decompression of certain metadata chunks can leave a dangling pointer in the library's internal decompression state. When an application finishes processing without reading the image rows, libpng attempts to read from this invalid memory location, resulting in an application crash."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-46675",
