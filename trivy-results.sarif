            {
              "id": "CVE-2026-98054",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "kernel: ASoC: Intel: avs: Fix unbalanced module reference count"
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:\n\nASoC: Intel: avs: Fix unbalanced module reference count\n\nstrace_open() invokes try_module_get() which on success takes\nthe module reference.  If any follow up operation causes\nstrace_open() to fail, the refcount shall be put down."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-98054",
