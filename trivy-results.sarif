            {
              "id": "CVE-2026-87864",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "curl: IMAP APPEND plus CRLF conversion command injection"
              },
              "fullDescription": {
                "text": "A flaw was found in curl. When curl is configured to perform carriage return and line feed (CRLF) conversion during an Internet Message Access Protocol (IMAP) append operation, it incorrectly reports the raw input size rather than the expanded byte count. Because the receiving server only reads the advertised length as message data, it interprets the remaining overflow bytes as subsequent commands. An attacker capable of supplying message data with line breaks can exploit this issue to execute unauthorized IMAP commands within an authenticated session."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-87864",
              "help": {
