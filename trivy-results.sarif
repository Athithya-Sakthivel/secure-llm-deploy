            {
              "id": "CVE-2026-80820",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:  x ..."
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:\n\nxfs: don't livelock in scrub on a circular unlinked list\n\nLOLLM points out that online fsck can livelock if an unlinked inode list\ncontains a loop.  Use a bitmap to detect cycles."
              },
