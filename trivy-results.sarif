            {
              "id": "CVE-2026-90105",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "kernel: vxlan: fix reading neigh ha"
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:\n\nvxlan: fix reading neigh ha\n\nCurrently arp/neigh_reduce read neigh ha directly which can lead to\npartial reads while the neigh is being updated. Use neigh_ha_snapshot to\ntake a stable snapshot of the address similar to route_shortcircuit which\nalready does the right thing."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-90105",
              "help": {
