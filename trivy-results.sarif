            {
              "id": "CVE-2026-80878",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "kernel: afs: Fix leak of ungot volume"
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:\n\nafs: Fix leak of ungot volume\n\nFix afs_lookup_volume_rcu() so that it doesn't leak a dying volume if\nafs_try_get_volume() fails."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-80878",
