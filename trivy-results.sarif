            {
              "id": "CVE-2026-92388",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "curl: curl: FTP wildcard write callback mixup"
              },
              "fullDescription": {
                "text": "A flaw was found in curl. A remote malicious server can cause a Denial of Service (DoS) or memory corruption in applications that enable File Transfer Protocol (FTP) wildcard matching. When a wildcard listing operation fails, curl does not properly reset its internal callback handlers before the connection handle is reused or duplicated. An application that subsequently reuses or clones this corrupted handle may experience an immediate application crash or unsafe memory access."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-92388",
